# ─────────────────────────────────────────────────────────────────────────────
# Pathora AI — BACKEND
# Copy to .env and fill in. Nothing here is required to boot: without a
# database the API answers 503 and the frontend falls back to local-only mode.
# ─────────────────────────────────────────────────────────────────────────────

PORT=4000
NODE_ENV=development

# Comma-separated origins allowed to call this API with credentials.
CORS_ORIGIN=http://localhost:3000

# ── Database ────────────────────────────────────────────────────────────────
# Omit to run the API without persistence (every DB route returns 503).
MONGODB_URI=
MONGODB_DB=pathora
# Only needed when the host resolver cannot answer SRV lookups, which makes a
# mongodb+srv:// URI fail with ECONNREFUSED. Leave blank almost everywhere.
DNS_SERVERS=

# ── Admin session ───────────────────────────────────────────────────────────
# ADMIN_PASSCODE gates the educator dashboard. AUTH_SECRET signs the session
# cookie. BOTH are required in production; in development they fall back to
# a demo passcode and a local secret.
ADMIN_PASSCODE=
AUTH_SECRET=

# ── Optional AI wording ─────────────────────────────────────────────────────
# Leave blank to use the deterministic answer (no key required). The model only
# rewords catalogue-grounded facts; it never scores, ranks or gates anything.
LLM_API_KEY=
LLM_BASE_URL=https://api.z.ai/api/paas/v4
LLM_MODEL=glm-4-flash

# "false" stops the three demo batches being written. Set it for any real
# database; leave it unset only for a throwaway local one.
SEED_SAMPLE_DATA=
