# ─────────────────────────────────────────────────────────────────────────────
# Pathora AI — FRONTEND
# Copy to .env.local. Everything here is optional: with no backend configured
# the app runs fully local-first in the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Where the API lives. Leave blank to assume the same origin (useful when a
# proxy forwards /api). Point it at the backend when they are deployed apart.
# NEXT_PUBLIC_* is inlined into the browser bundle, so never put a secret here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
