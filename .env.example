# Optional: server-side AI wording for mentor explanations.
# Leave these blank to use the built-in deterministic answer (no key required).
# Scoring, ranking and eligibility are always rule-based; the model only rewords
# catalog-grounded facts generated by the matching engine.
#
# Any OpenAI-compatible chat completions endpoint works. Z.ai defaults are shown.
LLM_API_KEY=
LLM_BASE_URL=https://api.z.ai/api/paas/v4
LLM_MODEL=glm-4-flash

# Aliases also accepted by the API route (the generic names above win):
# ZAI_API_KEY=
# OPENAI_API_KEY=
